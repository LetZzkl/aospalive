diff --git a/app/java/org/aliveclean/PlatformCompat.java b/app/java/org/aliveclean/PlatformCompat.java
new file mode 100644
index 0000000..fd0fec7
--- /dev/null
+++ b/app/java/org/aliveclean/PlatformCompat.java
@@ -0,0 +1,96 @@
+package org.aliveclean;
+
+import android.os.Build;
+
+/**
+ * 类原生适配层：集中判定这一台机器到底有哪些平台能力。
+ *
+ * OpenAlive 原本按 ColorOS 17 的 SystemUI 实现写死（com.oplus.systemui.aod.*、
+ * com.oplus.keyguard.*、com.oplus.wallpapers）。在 AOSP 系 ROM（Project Infinity X /
+ * LineageOS / 类原生）上这些类统统不存在，原来的写法是"找不到就静静 return"，
+ * 表现出来就是"模块装了但什么都不生效"，同时 WallpaperInfo.supportsAmbientMode
+ * 这类无条件 hook 又会误导系统 AOD 状态机。
+ *
+ * 这里把判定收敛到一处，让各注入点按实际平台走对应的分支。
+ */
+final class PlatformCompat {
+    private PlatformCompat(){}
+
+    /** 缓存结果，避免在 SystemUI 热路径上反复做类查找。 */
+    private static volatile int cachedFlags=-1;
+
+    private static final int F_COLOR_OS=1;          // ColorOS/OPPO 系 SystemUI
+    private static final int F_AOSP_AOD=2;          // AOSP Doze / 息屏 DreamService
+    private static final int F_AOSP_CLOCK=4;        // AOSP 锁屏时钟插件体系
+    private static final int F_COLOR_OS_WALLPAPER=8;// com.oplus.wallpapers 个性化注入
+
+    static boolean isColorOs(){return (flags()&F_COLOR_OS)!=0;}
+    static boolean hasAospAod(){return (flags()&F_AOSP_AOD)!=0;}
+    static boolean hasAospClock(){return (flags()&F_AOSP_CLOCK)!=0;}
+    static boolean hasColorOsWallpaper(){return (flags()&F_COLOR_OS_WALLPAPER)!=0;}
+
+    /** ColorOS 专属注入点（AOD 动画、锁屏时钟编辑器、指纹 AOD 等）是否可以装。 */
+    static boolean colorOsHooksAvailable(){return isColorOs();}
+
+    /** 类原生：没有 ColorOS 那套，但具备 AOSP 息屏链路。 */
+    static boolean isAospFamily(){return !isColorOs()&&hasAospAod();}
+
+    private static int flags(){
+        int value=cachedFlags;
+        if(value>=0)return value;
+        ClassLoader boot=ClassLoader.getSystemClassLoader();
+        int mask=0;
+        if(existsAny(boot,new String[]{
+            "com.oplus.systemui.aod.display.SmoothTransitionController",
+            "com.oplus.systemui.aod.common.AodManager",
+            "com.oplus.keyguard.OplusKeyguardUpdateMonitorExImpl"}))mask|=F_COLOR_OS;
+        if(existsAny(boot,new String[]{
+            "com.android.systemui.doze.DozeMachine",
+            "com.android.systemui.doze.DozeService"}))mask|=F_AOSP_AOD;
+        if(existsAny(boot,new String[]{
+            "com.android.systemui.lowlightclock.LowLightClockDreamService",
+            "com.android.systemui.plugins.keyguard.ui.clocks.ClockProvider"}))mask|=F_AOSP_CLOCK;
+        if(existsAny(boot,new String[]{
+            "com.oplus.wallpapers.business.themeedit.ThemeEditActivity"}))mask|=F_COLOR_OS_WALLPAPER;
+        // 首次判定可能发生在系统刚起、类还没全部可见的时刻；只有全部为 0 时才不缓存。
+        if(mask!=0)cachedFlags=mask;
+        return mask;
+    }
+
+    private static boolean existsAny(ClassLoader loader,String[] names){
+        for(String name:names){
+            try{Class.forName(name,false,loader);return true;}
+            catch(Throwable ignored){}
+            // SystemUI 的类在 boot loader 下不一定可见，直接问 ClassLoader 也行。
+            try{if(loader!=null&&loader.loadClass(name)!=null)return true;}catch(Throwable ignored){}
+        }
+        return false;
+    }
+
+    /** 用传入的 SystemUI classLoader 重新判定一次（在 hook 回调里拿到真实 loader 后调用）。 */
+    static void refresh(ClassLoader systemUiLoader){
+        int mask=0;
+        if(existsAny(systemUiLoader,new String[]{
+            "com.oplus.systemui.aod.display.SmoothTransitionController",
+            "com.oplus.systemui.aod.common.AodManager",
+            "com.oplus.keyguard.OplusKeyguardUpdateMonitorExImpl"}))mask|=F_COLOR_OS;
+        if(existsAny(systemUiLoader,new String[]{
+            "com.android.systemui.doze.DozeMachine",
+            "com.android.systemui.doze.DozeService"}))mask|=F_AOSP_AOD;
+        if(existsAny(systemUiLoader,new String[]{
+            "com.android.systemui.lowlightclock.LowLightClockDreamService",
+            "com.android.systemui.plugins.keyguard.ui.clocks.ClockProvider"}))mask|=F_AOSP_CLOCK;
+        if(mask!=0)cachedFlags=mask;
+    }
+
+    static String describe(){
+        int mask=flags();
+        StringBuilder text=new StringBuilder();
+        text.append("ROM=").append(Build.BRAND).append('/').append(Build.DEVICE)
+            .append(" A").append(Build.VERSION.RELEASE).append(" API").append(Build.VERSION.SDK_INT);
+        text.append(" coloros=").append((mask&F_COLOR_OS)!=0);
+        text.append(" aospAod=").append((mask&F_AOSP_AOD)!=0);
+        text.append(" aospClock=").append((mask&F_AOSP_CLOCK)!=0);
+        return text.toString();
+    }
+}

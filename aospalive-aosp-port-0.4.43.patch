diff --git a/app/java/org/aliveclean/FallbackHome.java b/app/java/org/aliveclean/FallbackHome.java
new file mode 100644
index 0000000..aa1dc98
--- /dev/null
+++ b/app/java/org/aliveclean/FallbackHome.java
@@ -0,0 +1,188 @@
+package org.aliveclean;
+
+import android.app.Activity;
+import android.app.WallpaperManager;
+import android.content.ComponentName;
+import android.content.Intent;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+/**
+ * 类原生降级首页。
+ *
+ * 原版首页直接把 Flyme/ColorOS 的"个性化"页资源（activity_system_customize_center 等）
+ * inflate 出来，在 AOSP 系 ROM 上资源表或主题一缺失就整页失败，
+ * 原来的处理是弹个对话框然后 finish —— 用户看到的就是"打开没画面"。
+ *
+ * 这里提供的是一条不依赖任何外挂资源的入口，只做三件事：
+ * 1. 说明当前平台被识别成什么（出问题时这行就是诊断依据）
+ * 2. 直达系统壁纸选择器，把 CleanWallpaper 设上去（AOSP 标准 Intent）
+ * 3. 仍然能进原来的编辑页 / 通知光效；进不去就把原因写在这页上，而不是静默黑屏
+ */
+public final class FallbackHome extends Activity {
+    static final String EXTRA_REASON="reason";
+    private TextView moduleState;
+
+    @Override protected void onCreate(Bundle state){
+        super.onCreate(state);
+        String reason=getIntent()!=null?getIntent().getStringExtra(EXTRA_REASON):null;
+        float d=getResources().getDisplayMetrics().density;
+
+        ScrollView scroll=new ScrollView(this);
+        scroll.setBackgroundColor(0xff0b0d10);
+        LinearLayout page=new LinearLayout(this);
+        page.setOrientation(LinearLayout.VERTICAL);
+        page.setPadding(dp(d,20),dp(d,56),dp(d,20),dp(d,40));
+        scroll.addView(page,new ViewGroup.LayoutParams(-1,-2));
+
+        TextView title=text("aospalive",22,0xffeef2f6,true);
+        page.addView(title);
+        TextView sub=text("类原生适配入口",13,0xff8b96a5,false);
+        sub.setPadding(0,dp(d,4),0,dp(d,22));
+        page.addView(sub);
+
+        // 降级页也要能看到模块到底注入没有 —— 这一页本来就是出问题时的诊断入口，
+        // 状态只藏在上一个界面里等于没给用户任何抓手。点一下列出三条回执通道。
+        moduleState=text("LSP 检测中…",12,0xff8b96a5,false);
+        moduleState.setPadding(0,0,0,dp(d,14));
+        moduleState.setOnClickListener(v->new android.app.AlertDialog.Builder(this)
+            .setTitle("LSP 模块状态")
+            .setMessage(ModuleActivation.describe(this))
+            .setPositiveButton("关闭",null)
+            .show());
+        page.addView(moduleState);
+
+        page.addView(card(d,"平台识别",PlatformCompat.describe(),0xff9fd8ff));
+        page.addView(card(d,"说明",
+            PlatformCompat.isColorOs()
+                ?"检测到 ColorOS 系 SystemUI，原版功能可用。"
+                :"当前是 AOSP 系 ROM：原版面向 ColorOS 的注入点不存在，功能按类原生路径降级运行。",
+            0xffc8d2de));
+
+        page.addView(action(d,"设为 Alive 壁纸",()->{
+            Intent intent=new Intent(WallpaperManager.ACTION_CHANGE_LIVE_WALLPAPER);
+            intent.putExtra(WallpaperManager.EXTRA_LIVE_WALLPAPER_COMPONENT,
+                new ComponentName(this,CleanWallpaper.class));
+            try{startActivity(intent);}
+            catch(Exception failure){toast("系统没有壁纸选择器："+failure);}
+        }));
+
+        page.addView(action(d,"打开编辑器",()->{
+            try{startActivity(new Intent(this,MainActivity.class));}
+            catch(Exception failure){toast("编辑器打不开："+failure);}
+        }));
+
+        page.addView(action(d,"通知光效设置",()->{
+            try{startActivity(new Intent(this,NotificationSettingsActivity.class));}
+            catch(Exception failure){toast("页面打不开："+failure);}
+        }));
+
+        page.addView(action(d,"重试原版界面",()->{
+            getSharedPreferences("aosp_fallback",0).edit().putBoolean("enabled",false).apply();
+            Intent home=new Intent(this,HomeActivity.class);
+            home.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP);
+            try{startActivity(home);}catch(Exception failure){toast("打不开："+failure);}
+            finish();
+        }));
+
+        if(reason!=null&&!reason.isEmpty()){
+            page.addView(card(d,"原版首页失败原因",reason,0xffff9a9a));
+        }
+
+        TextView hint=text("模块本身在系统中生效，与这个界面能否打开无关。壁纸装上后即可测试息屏衔接。",
+            12,0xff6f7a88,false);
+        hint.setPadding(0,dp(d,20),0,0);
+        page.addView(hint);
+
+        setContentView(scroll);
+        getWindow().setStatusBarColor(0xff0b0d10);
+        getWindow().setNavigationBarColor(0xff0b0d10);
+    }
+
+    @Override protected void onResume(){
+        super.onResume();
+        refreshModule();
+    }
+
+    /** 请模块回执一次，600ms 后读结果；读的是三条通道的合并状态。 */
+    private void refreshModule(){
+        final TextView label=moduleState;
+        if(label==null)return;
+        ModuleActivation.request(this);
+        new Thread(()->{
+            boolean active=false;
+            for(int attempt=0;attempt<6;attempt++){
+                try{Thread.sleep(250);}catch(InterruptedException stop){return;}
+                if(ModuleActivation.active(getApplicationContext())){active=true;break;}
+            }
+            final boolean state=active;
+            runOnUiThread(()->{
+                if(isDestroyed()||moduleState!=label)return;
+                label.setText(state?"LSP 已激活 · 点开看详情":"LSP 未激活 · 点开看详情");
+                label.setTextColor(state?0xff35ba79:0xffe07b7b);
+            });
+        },"aospalive-FallbackStatus").start();
+    }
+
+    private TextView text(String value,int size,int color,boolean bold){
+        TextView view=new TextView(this);
+        view.setText(value);
+        view.setTextSize(size);
+        view.setTextColor(color);
+        if(bold)view.setTypeface(Typeface.DEFAULT_BOLD);
+        return view;
+    }
+
+    private View card(float d,String head,String body,int accent){
+        LinearLayout box=new LinearLayout(this);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(dp(d,16),dp(d,14),dp(d,16),dp(d,14));
+        GradientDrawable background=new GradientDrawable();
+        background.setColor(0xff14181d);
+        background.setCornerRadius(dp(d,14));
+        box.setBackground(background);
+        LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,-2);
+        lp.bottomMargin=dp(d,10);
+        box.setLayoutParams(lp);
+        TextView title=text(head,12,accent,true);
+        box.addView(title);
+        TextView value=text(body,13,0xffc8d2de,false);
+        value.setPadding(0,dp(d,6),0,0);
+        value.setTextIsSelectable(true);
+        box.addView(value);
+        return box;
+    }
+
+    private View action(float d,String label,Runnable click){
+        TextView view=new TextView(this);
+        view.setText(label);
+        view.setTextSize(15);
+        view.setTextColor(0xffeef2f6);
+        view.setGravity(Gravity.CENTER_VERTICAL);
+        view.setPadding(dp(d,18),dp(d,16),dp(d,18),dp(d,16));
+        GradientDrawable background=new GradientDrawable();
+        background.setColor(0xff1b2129);
+        background.setCornerRadius(dp(d,14));
+        background.setStroke(1,0xff2a3341);
+        view.setBackground(background);
+        LinearLayout.LayoutParams lp=new LinearLayout.LayoutParams(-1,-2);
+        lp.bottomMargin=dp(d,10);
+        view.setLayoutParams(lp);
+        view.setOnClickListener(v->click.run());
+        return view;
+    }
+
+    private void toast(String message){
+        android.widget.Toast.makeText(this,message,android.widget.Toast.LENGTH_LONG).show();
+    }
+
+    private int dp(float density,float value){return Math.round(density*value);}
+}

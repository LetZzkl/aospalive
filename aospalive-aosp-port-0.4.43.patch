diff --git a/app/java/org/aliveclean/UiResourceLoader.java b/app/java/org/aliveclean/UiResourceLoader.java
new file mode 100644
index 0000000..0a8ded9
--- /dev/null
+++ b/app/java/org/aliveclean/UiResourceLoader.java
@@ -0,0 +1,135 @@
+package org.aliveclean;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.res.AssetManager;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+import android.util.DisplayMetrics;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+
+/**
+ * 类原生适配：把"外挂 UI apk 的资源"用更可靠的方式取出来。
+ *
+ * 关键约束（原实现注释里写过，上一版改动把它丢了）：
+ * 外挂 APK 的 XML drawable 里有 Flyme 自定义类（MzPressAnimationDrawable 等），
+ * 反序列化时用的是 Resources 自己的 ClassLoader。
+ *   - PackageManager.getResourcesForApplication() 返回的 Resources 带应用自己的
+ *     ClassLoader，能正常解析这些 drawable；
+ *   - 直接 new Resources(AssetManager,...)（public 三参构造器）用的是 boot
+ *     ClassLoader，解析自定义 drawable 必抛 ClassNotFoundException，
+ *     表现出来就是「布局加载失败 / Error inflating class」。
+ *
+ * 所以这里把 PM 路径当首选，并且用真正要用的 layout 资源做探测；
+ * 只有 PM 路径真的抛异常才退到 AssetManager 路径，并在那条路径上尽量
+ * 把 ClassLoader 换成应用自己的。
+ */
+final class UiResourceLoader {
+    private UiResourceLoader(){}
+
+    static final class Bundle {
+        final Resources resources;
+        final Resources.Theme theme;
+        final String via;
+        Bundle(Resources resources,Resources.Theme theme,String via){
+            this.resources=resources;this.theme=theme;this.via=via;
+        }
+    }
+
+    /**
+     * @param probeType 资源类型（用调用方真正会 inflate 的资源最准）
+     * @param probeName 资源名
+     */
+    static Bundle load(Context base,String apkPath,String packageName,
+                       String themeStyle,String probeType,String probeName){
+        Bundle first=viaPackageManager(base,apkPath,packageName,themeStyle);
+        if(usable(first,probeType,probeName,packageName))return first;
+        Bundle second=viaAssetManager(base,apkPath,packageName,themeStyle);
+        if(usable(second,probeType,probeName,packageName))return second;
+        // 两条路径都没通过严格探测：优先用 PM 的，它的 ClassLoader 仍然是对的。
+        if(first!=null)return first;
+        return second;
+    }
+
+    private static boolean usable(Bundle bundle,String type,String name,String pkg){
+        if(bundle==null||bundle.resources==null)return false;
+        if(type==null)return true;
+        Resources resources=bundle.resources;
+        // 依次尝试：显式包名 -> 任意包 -> 默认包。原实现只用 "*"，在
+        // Android 16/17 上对未安装的外挂包会稳定返回 0，导致明明可用却降级。
+        String[] packages=pkg!=null?new String[]{pkg,"*",null}:new String[]{"*",null};
+        for(String candidate:packages){
+            try{
+                if(resources.getIdentifier(name,type,candidate)!=0)return true;
+            }catch(Throwable ignored){}
+        }
+        return false;
+    }
+
+    @SuppressWarnings("deprecation")
+    private static Bundle viaPackageManager(Context base,String apkPath,String packageName,String themeStyle){
+        try{
+            ApplicationInfo info=new ApplicationInfo();
+            info.packageName=packageName;
+            info.uid=android.os.Process.myUid();
+            info.sourceDir=info.publicSourceDir=apkPath;
+            info.targetSdkVersion=base.getApplicationInfo().targetSdkVersion;
+            Resources resources=base.getPackageManager().getResourcesForApplication(info);
+            if(resources==null)return null;
+            return new Bundle(resources,themeOf(resources,themeStyle,packageName),"pm");
+        }catch(Throwable ignored){return null;}
+    }
+
+    @SuppressWarnings("deprecation")
+    private static Bundle viaAssetManager(Context base,String apkPath,String packageName,String themeStyle){
+        try{
+            AssetManager assets=AssetManager.class.getConstructor().newInstance();
+            java.lang.reflect.Method add=AssetManager.class.getMethod("addAssetPath",String.class);
+            Object cookie=add.invoke(assets,apkPath);
+            if(cookie instanceof Integer&&((Integer)cookie)==0)return null;
+            Resources resources=newResources(base,assets);
+            return new Bundle(resources,themeOf(resources,themeStyle,packageName),"asset");
+        }catch(Throwable ignored){return null;}
+    }
+
+    /**
+     * 造一个把 ClassLoader 指到应用自己的 Resources。
+     *
+     * 优先用带 ClassLoader 参数的构造器（部分 ROM 保留），失败再退回公开三参
+     * 构造器，然后尝试把 mClassLoader 字段改掉。全失败也返回 Resources：
+     * 资源表本身是好的，只是自定义 drawable 可能解析不了，比整页打不开强。
+     */
+    private static Resources newResources(Context base,AssetManager assets){
+        DisplayMetrics metrics=base.getResources().getDisplayMetrics();
+        Configuration config=new Configuration(base.getResources().getConfiguration());
+        ClassLoader loader=base.getClassLoader();
+        try{
+            Constructor<Resources> constructor=Resources.class.getDeclaredConstructor(
+                AssetManager.class,DisplayMetrics.class,Configuration.class,ClassLoader.class);
+            constructor.setAccessible(true);
+            Resources resources=constructor.newInstance(assets,metrics,config,loader);
+            if(resources!=null)return resources;
+        }catch(Throwable ignored){}
+        Resources resources=new Resources(assets,metrics,config);
+        try{
+            Field field=Resources.class.getDeclaredField("mClassLoader");
+            field.setAccessible(true);
+            field.set(resources,loader);
+        }catch(Throwable ignored){}
+        return resources;
+    }
+
+    private static Resources.Theme themeOf(Resources resources,String themeStyle,String packageName){
+        Resources.Theme theme=resources.newTheme();
+        if(themeStyle==null)return theme;
+        // 不要把宿主 App 的主题 setTo 进来：两套资源表的属性 ID 不同，
+        // 混进来会让 style 里的 ?attr 解析到不存在的资源，Button 之类直接崩。
+        int style=resources.getIdentifier(themeStyle,"style",packageName);
+        if(style==0)style=resources.getIdentifier(themeStyle,"style","*");
+        if(style==0)style=resources.getIdentifier(themeStyle,"style",null);
+        if(style!=0)theme.applyStyle(style,true);
+        return theme;
+    }
+}
